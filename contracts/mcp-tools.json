          "type": "string",
          "minLength": 1
        },
        "unassign": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "renew_lease",
    "title": "Renew lease",
